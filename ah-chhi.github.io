<html><head></head><body style="overflow-wrap: break-word; -webkit-nbsp-mode: space; line-break: after-white-space;"><div>&lt;!DOCTYPE html&gt;</div><div>&lt;html lang="km"&gt;</div><div>&lt;head&gt;</div><div>&nbsp; &nbsp; &lt;meta charset="UTF-8"&gt;</div><div>&nbsp; &nbsp; &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;</div><div>&nbsp; &nbsp; &lt;title&gt;ពិធីអាពាហ៍ពិពាហ៍ ឈិត ច័ន្ទរ៉ា &amp; ទេព ថេត&lt;/title&gt;</div><div>&nbsp; &nbsp; &lt;!-- Google Fonts - Hanuman &amp; Moul --&gt;</div><div>&nbsp; &nbsp; &lt;link href="https://fonts.googleapis.com/css2?family=Hanuman:wght@300;400;700&amp;family=Moul&amp;display=swap" rel="stylesheet"&gt;</div><div>&nbsp; &nbsp; &lt;style&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; * {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; box-sizing: border-box;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin: 0;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; padding: 0;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; body {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-family: 'Hanuman', serif;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; background: linear-gradient(135deg, #ff7e5f, #feb47b, #ff758c, #ff7eb3);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; background-size: 400% 400%;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; animation: gradientBG 15s ease infinite;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; color: #fff;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; min-height: 100vh;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; display: flex;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; justify-content: center;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; align-items: center;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; padding: 20px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; @keyframes gradientBG {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 0% { background-position: 0% 50%; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 50% { background-position: 100% 50%; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 100% { background-position: 0% 50%; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; /* ក្របខ័ណ្ឌធៀបការ និងរបងក្បាច់ចរនាបទខ្មែរ */</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .invitation-card {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; position: relative;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; width: 100%;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; max-width: 600px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; background: rgba(20, 20, 20, 0.75);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; backdrop-filter: blur(10px);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-radius: 20px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; padding: 40px 30px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; box-shadow: 0 15px 35px rgba(0,0,0,0.5);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border: 8px solid #d4af37;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; text-align: center;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; /* ក្បាច់ចររបងជុំវិញ និងផ្កាវារទំ (จำลองដោយព្រំដែន និងក្បាច់) */</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .invitation-card::before {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; content: '';</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; position: absolute;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; top: -12px; left: -12px; right: -12px; bottom: -12px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border: 3px dashed #ffd700;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-radius: 25px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; pointer-events: none;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; h1 {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-family: 'Moul', serif;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 26px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; color: #ffd700;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin-bottom: 10px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; text-shadow: 2px 2px 4px rgba(0,0,0,0.6);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .subtitle {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 16px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; color: #fce4ec;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin-bottom: 20px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; /* ស៊ុំរូបថត និងផ្នែករូបភាពហូសពេញផ្ទៃ ៥ សន្លឹក */</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .photo-container {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; position: relative;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; width: 100%;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; height: 350px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-radius: 15px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; overflow: hidden;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border: 5px solid #d4af37;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; box-shadow: 0 8px 20px rgba(0,0,0,0.4);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin-bottom: 25px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .slideshow {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; position: absolute;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; width: 100%;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; height: 100%;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; opacity: 0;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; transition: opacity 1s ease-in-out;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; background-size: cover;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; background-position: center;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .slideshow.active {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; opacity: 1;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; /* ឈ្មោះកូនកំលោះ កូនក្រមុំ */</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .couple-names {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 24px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-weight: bold;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; color: #ffeb3b;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin: 15px 0;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-family: 'Moul', serif;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .parents-section {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 14px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; line-height: 1.6;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; background: rgba(255, 255, 255, 0.1);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; padding: 15px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-radius: 10px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin-bottom: 20px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border: 1px solid rgba(255, 215, 0, 0.3);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .event-details {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin: 20px 0;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; text-align: left;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; background: rgba(0,0,0,0.3);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; padding: 15px 20px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-radius: 10px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-left: 5px solid #ffd700;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .event-details h3 {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-family: 'Moul', serif;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 16px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; color: #ffd700;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin-bottom: 10px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; text-align: center;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .event-details ul {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; list-style-type: none;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 14px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; line-height: 1.8;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; /* រាប់ថយក្រោយ */</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .countdown {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; display: flex;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; justify-content: center;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; gap: 15px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin: 20px 0;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .time-box {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; background: rgba(212, 175, 55, 0.2);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border: 1px solid #ffd700;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; padding: 10px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-radius: 8px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; min-width: 60px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .time-box span {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; display: block;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 18px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-weight: bold;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; color: #ffd700;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .time-box label {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 11px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; color: #fff;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; /* ពណ៌ឈុតភ្ញៀវ */</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .dress-code {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; background: rgba(255, 255, 255, 0.15);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; padding: 12px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-radius: 10px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin: 20px 0;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 14px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .color-dots {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; display: flex;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; justify-content: center;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; gap: 10px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin-top: 8px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .dot {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; width: 22px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; height: 22px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-radius: 50%;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border: 2px solid #fff;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; /* ប៊ូតុងផ្សេងៗ */</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .btn-group {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; display: flex;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; flex-direction: column;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; gap: 12px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; margin-top: 25px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .btn {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; display: block;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; width: 100%;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; padding: 12px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; border-radius: 25px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; text-decoration: none;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-weight: bold;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; font-size: 15px;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; transition: all 0.3s ease;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; box-shadow: 0 4px 10px rgba(0,0,0,0.3);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; text-align: center;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .btn-map { background: #4CAF50; color: white; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .btn-map:hover { background: #43A047; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .btn-pay { background: #00838F; color: white; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .btn-pay:hover { background: #006064; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; .btn-contact { background: #0088cc; color: white; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; .btn-contact:hover { background: #0077b5; }</div><div>&nbsp; &nbsp; &lt;/style&gt;</div><div>&lt;/head&gt;</div><div>&lt;body&gt;</div><div><br></div><div>&nbsp; &nbsp; &lt;div class="invitation-card"&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;h1&gt;ពិធីអាពាហ៍ពិពាហ៍&lt;/h1&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;p class="subtitle"&gt;សិរីសួស្តីអាពាហ៍ពិពាហ៍ប្រពៃណីខ្មែរ&lt;/p&gt;</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;!-- រូបថតហូសបន្តបន្ទាប់គ្នា ៥ សន្លឹក (ជំនួសតំណររូបភាពរបស់អ្នកនៅទីនេះ) --&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="photo-container"&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="slideshow active" style="background-image: url('https://picsum.photos/id/1015/600/350');"&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="slideshow" style="background-image: url('https://picsum.photos/id/1025/600/350');"&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="slideshow" style="background-image: url('https://picsum.photos/id/1040/600/350');"&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="slideshow" style="background-image: url('https://picsum.photos/id/1062/600/350');"&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="slideshow" style="background-image: url('https://picsum.photos/id/1074/600/350');"&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;!-- ឈ្មោះកូនកំលោះ និងកូនក្រមុំ --&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="couple-names"&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; លោក ឈិត ច័ន្ទរ៉ា &amp; អ្នកនាង/កញ្ញា ទេព ថេត</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;!-- ព័ត៌មានឪពុកម្តាយ --&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="parents-section"&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;&lt;strong&gt;ឪពុកខាងប្រុស៖&lt;/strong&gt; ឈឹម រិទ្ធី &amp;nbsp;|&amp;nbsp; &lt;strong&gt;ម្តាយខាងប្រុស៖&lt;/strong&gt; ស៊ុយ សំបូរ&lt;/p&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p style="margin-top: 5px;"&gt;&lt;strong&gt;ម្តាយខាងស្រី៖&lt;/strong&gt; ឈិត សុខា&lt;/p&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p style="margin-top: 10px; color: #ffd700;"&gt;កាលបរិច្ឆេទ៖ ថ្ងៃទី ២៥ ខែ ធ្នូ ឆ្នាំ ២០២៦ (ខេត្តកំពត)&lt;/p&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;!-- ចំនួនថ្ងៃរាប់ថយក្រោយ --&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="countdown"&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="time-box"&gt;&lt;span id="days"&gt;00&lt;/span&gt;&lt;label&gt;ថ្ងៃ&lt;/label&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="time-box"&gt;&lt;span id="hours"&gt;00&lt;/span&gt;&lt;label&gt;ម៉ោង&lt;/label&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="time-box"&gt;&lt;span id="minutes"&gt;00&lt;/span&gt;&lt;label&gt;នាទី&lt;/label&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="time-box"&gt;&lt;span id="seconds"&gt;00&lt;/span&gt;&lt;label&gt;វិនាទី&lt;/label&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;!-- កម្មវិធីតាមពេលវេលា --&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="event-details"&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h3&gt;កម្មវិធីបុណ្យប្រពៃណីខ្មែរ&lt;/h3&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;ul&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;li&gt;⏰ &lt;strong&gt;ម៉ោង ០៧:០០ ព្រឹក៖&lt;/strong&gt; ពិធីជួបជុំញាតិមិត្តសន្ដានទាំងសងខាង&lt;/li&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;li&gt;⏰ &lt;strong&gt;ម៉ោង ០៨:០០ ព្រឹក៖&lt;/strong&gt; ពិធីសូត្រមន្តចម្រើនព្រះបរិត្ត&lt;/li&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;li&gt;⏰ &lt;strong&gt;ម៉ោង ០៩:៣០ ព្រឹក៖&lt;/strong&gt; ពិធីហែជំនូន និងសំពះផ្ទឹម&lt;/li&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;li&gt;⏰ &lt;strong&gt;ម៉ោង ០៥:០០ ល្ងាច៖&lt;/strong&gt; ពិធីជប់លៀងអបអរសាទរ&lt;/li&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/ul&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;!-- ពណ៌ឈុតភ្ញៀវ --&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="dress-code"&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;&lt;strong&gt;ពណ៌ឈុតភ្ញៀវចូលរួម៖&lt;/strong&gt;&lt;/p&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="color-dots"&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="dot" style="background-color: #004d40;" title="ប៉ៃតងចាស់"&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="dot" style="background-color: #6a1b9a;" title="ផ្កាត្របែកព្រៃ"&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="dot" style="background-color: #558b2f;" title="ស្លែ"&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="dot" style="background-color: #f48fb1;" title="ផ្កាឈូក"&gt;&lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;!-- ប៊ូតុងបញ្ជាផ្សេងៗ --&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="btn-group"&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="https://maps.app.goo.gl/bD6FBGFFjnxDKPAo8?g_st=ic" target="_blank" class="btn btn-map"&gt;📍 មើលទីតាំងកម្មវិធី (Map)&lt;/a&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="https://pay.ababank.com/oRF8/3l6ziawv" target="_blank" class="btn btn-pay"&gt;💳 បាញ់ទឹកប្រាក់ចំណងដៃ (ABA)&lt;/a&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="https://t.me/boy_ras" target="_blank" class="btn btn-contact"&gt;💬 ទំនាក់ទំនងអ្នកផ្ដល់ព័ត៌មាន (Telegram)&lt;/a&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</div><div>&nbsp; &nbsp; &lt;/div&gt;</div><div><br></div><div>&nbsp; &nbsp; &lt;script&gt;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; /* ប្រព័ន្ធហូសរូបភាពបន្តបន្ទាប់គ្នា (៥ សន្លឹក) */</div><div>&nbsp; &nbsp; &nbsp; &nbsp; let currentIndex = 0;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; const slides = document.querySelectorAll('.slideshow');</div><div>&nbsp; &nbsp; &nbsp; &nbsp; function nextSlide() {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; slides[currentIndex].classList.remove('active');</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; currentIndex = (currentIndex + 1) % slides.length;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; slides[currentIndex].classList.add('active');</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; setInterval(nextSlide, 3500); // ប្តូររូបភាពរៀងរាល់ ៣.៥ វិនាទី</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; /* កម្មវិធីរាប់ថយក្រោយដល់ថ្ងៃទី 25/12/2026 */</div><div>&nbsp; &nbsp; &nbsp; &nbsp; const weddingDate = new Date("December 25, 2026 00:00:00").getTime();</div><div>&nbsp; &nbsp; &nbsp; &nbsp; const countdownTimer = setInterval(() =&gt; {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const now = new Date().getTime();</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const distance = weddingDate - now;</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (distance &lt; 0) {</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; clearInterval(countdownTimer);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.querySelector(".countdown").innerHTML = "&lt;p&gt;ថ្ងៃពិធីបានមកដល់ហើយ!&lt;/p&gt;";</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const days = Math.floor(distance / (1000 * 60 * 60 * 24));</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const seconds = Math.floor((distance % (1000 * 60)) / 1000);</div><div><br></div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById("days").innerText = String(days).padStart(2, '0');</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById("hours").innerText = String(hours).padStart(2, '0');</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById("minutes").innerText = String(minutes).padStart(2, '0');</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById("seconds").innerText = String(seconds).padStart(2, '0');</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }, 1000);</div><div>&nbsp; &nbsp; &lt;/script&gt;</div><div>&lt;/body&gt;</div><div>&lt;/html&gt;</div></body></html>